# --- Server ---
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# --- Admin ---
# Token required for /admin/* endpoints (key management). Change this!
ADMIN_TOKEN=change-me-admin-token

# --- Infrastructure ---
REDIS_URL=redis://localhost:6379
# (compose maps the pgvector container to host port 5433)
DATABASE_URL=postgres://tokenflow:tokenflow@localhost:5433/tokenflow

# --- Backends ---
# JSON array of inference backends (vLLM / TGI OpenAI-compatible endpoints).
# capacityTokens ~ KV-cache token capacity used for admission control & balancing.
BACKENDS=[{"name":"vllm-0","url":"http://localhost:8001","capacityTokens":32768},{"name":"vllm-1","url":"http://localhost:8002","capacityTokens":32768}]
# How often to poll backend /metrics + /health (ms)
BACKEND_POLL_INTERVAL_MS=1000

# --- Token estimation / admission ---
# Requests with estimated weight >= this are "heavy" (routed to the freest backend)
HEAVY_PROMPT_THRESHOLD=2048
# Default output budget when max_tokens is absent from the request
DEFAULT_MAX_TOKENS=1024
# How long a request may wait in the queue before 503 (ms)
QUEUE_TIMEOUT_MS=30000
# Crash backstop for shared capacity reservations (seconds): orphaned
# reservations expire after this instead of pinning a backend "full"
RESERVATION_TTL_SECONDS=120

# --- Caching ---
CACHE_ENABLED=true
# Only cache deterministic requests: temperature <= this value
CACHE_MAX_TEMPERATURE=0
CACHE_TTL_SECONDS=3600
# Semantic cache (requires pgvector + an OpenAI-compatible /v1/embeddings endpoint)
SEMANTIC_CACHE_ENABLED=true
EMBEDDING_URL=http://localhost:8001
EMBEDDING_MODEL=mock-embed
EMBEDDING_DIM=384
# Cosine distance threshold: lower = stricter match (0 = identical)
SEMANTIC_DISTANCE_THRESHOLD=0.05
